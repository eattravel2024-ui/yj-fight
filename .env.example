# Copy only to an external private file, e.g. /etc/azhi71.env (root:azhi71 0640).
# Guest arcade/practice/custom rooms work without DATABASE_URL.
HOST=127.0.0.1
PORT=31071
AZHI_SNAPSHOT_HZ=30
NODE_ENV=production
# Required for accounts: canonical HTTPS origin, no path or trailing slash.
APP_ORIGIN=https://game.example.com
# Percent-encode the password. Keep the database bound to loopback/private network.
DATABASE_URL=postgresql://azhi_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:15432/azhi
AZHI_REGION=asia
# Only enable if a loopback reverse proxy overwrites X-Real-IP for every request.
TRUST_PROXY_LOOPBACK=false
# SMTP is required for registration, email verification and password resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_FROM=Game <noreply@example.com>
SMTP_USER=
SMTP_PASSWORD=
# Optional Google OAuth. Callback: APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development-only opt-in migrations; ignored in NODE_ENV=production.
AZHI_AUTO_MIGRATE=0
