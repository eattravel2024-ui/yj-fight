# Copy/reconcile these directives INSIDE the existing HTTPS server block for this
# game's dedicated origin. Do not overwrite another website's server/location.
# Keep the site's existing listen 443 ssl, server_name and certificate settings.
client_max_body_size 32k;
add_header X-Content-Type-Options nosniff always;
add_header Referrer-Policy strict-origin-when-cross-origin always;

location / {
    proxy_pass http://127.0.0.1:31071;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    # There is exactly one trusted local reverse proxy in this example. Replace
    # rather than append client-supplied forwarded addresses to prevent spoofing.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
}
